{
  "name": "yamds-bill",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "description": "Yamds记账 · Android 端 Tauri 模板（Rust + React）",
  "scripts": {
    "dev": "vite --config src/vite.config.ts",
    "build": "tsc -p src/tsconfig.json && vite build --config src/vite.config.ts",
    "typecheck": "tsc -p src/tsconfig.json --noEmit",
    "test:unit": "vitest run --config src/vitest.config.ts --dir src",
    "ts-bindings": "cargo test -p tk-domain --lib export_bindings_ -- --quiet",
    "icons": "node scripts/build-icon-subset.mjs",
    "icons:check": "node scripts/build-icon-subset.mjs --check",
    "rust:check": "cargo check --workspace --all-targets",
    "rust:test": "cargo test --workspace",
    "verify": "pnpm run typecheck && pnpm run rust:check",
    "tauri": "tauri",
    "android:init": "tauri android init",
    "android:dev": "tauri android dev",
    "android:build": "tauri android build --apk",
    "icon": "tauri icon src/assets/app-icon.png",
    "check:versions": "node -e \"const fs=require('fs');const p=JSON.parse(fs.readFileSync('package.json','utf8'));const t=JSON.parse(fs.readFileSync('src-tauri/tauri.conf.json','utf8'));if(p.version!==t.version)process.exit(1);console.log('version metadata is consistent:',p.version)\""
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.0",
    "@codemirror/state": "^6.7.4",
    "@codemirror/view": "^6.43.11",
    "@fontsource-variable/inter": "^5.2.8",
    "@fontsource-variable/jetbrains-mono": "^5.2.8",
    "@fontsource-variable/plus-jakarta-sans": "^5.2.8",
    "@gsap/react": "^2.1.2",
    "@iconify/react": "^6.0.2",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-context-menu": "^2.3.7",
    "@radix-ui/react-dialog": "^1.1.6",
    "@radix-ui/react-popover": "^1.1.6",
    "@radix-ui/react-radio-group": "^1.3.8",
    "@radix-ui/react-select": "^2.1.6",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.3",
    "@radix-ui/react-toast": "^1.2.6",
    "@radix-ui/react-tooltip": "^1.2.1",
    "@tanstack/react-query": "^5.32.0",
    "@tauri-apps/api": "^2.0.0",
    "@tauri-apps/plugin-opener": "^2.5.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "gsap": "^3.15.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.6.0"
  },
  "devDependencies": {
    "@iconify-json/mdi": "^1.2.3",
    "@iconify-json/simple-icons": "^1.2.96",
    "@tailwindcss/vite": "^4.0.0",
    "@tauri-apps/cli": "^2.0.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.2.1",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.4.5",
    "vite": "^5.2.11",
    "vitest": "^2.1.9"
  }
}
