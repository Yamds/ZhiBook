{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "制账",
  "version": "0.1.0",
  "identifier": "cafe.yamds.bill",
  "build": {
    "beforeDevCommand": "pnpm run dev",
    "beforeBuildCommand": "pnpm run build",
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5180"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "制账",
        "width": 960,
        "height": 720,
        "resizable": true,
        "center": true,
        "visible": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "publisher": "Yamds",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
